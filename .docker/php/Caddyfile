# https://frankenphp.dev/docs/config
# https://caddyserver.com/docs/caddyfile

{
	# The image's HEALTHCHECK polls localhost:2019/metrics
	admin localhost:2019

	# Plain HTTP: HTTPS is terminated by Cloudflare Tunnel
	auto_https off
	skip_install_trust
}

:80 {
	root public/
	encode zstd br gzip

	php_server {
		# Symfony Runtime detects the worker by itself (FrankenPhpWorkerRunner): the kernel boots once per worker
		worker {
			file ./public/index.php
			# Dev sets it to "watch" in compose.override.yaml, so that code changes restart the workers
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}
}
