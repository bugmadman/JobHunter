###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

# Docker: committed defaults; put machine-specific values into .env.local (make init creates it)
APP_NAME=jobhunter
APP_PORT=8080
# The host user's name and UID own the files the php container creates in the project
APP_USER=app
APP_USERID=1000

POSTGRES_DB=app
POSTGRES_USER=app
# Used as is by both Postgres and DATABASE_URL, so it cannot be URL-encoded: avoid @ : / ? # & %
POSTGRES_PASSWORD=app
# Dev only: compose.override.yaml publishes the DB on 127.0.0.1 at this port
POSTGRES_PORT=5432

# The real value lives only in .env.local (make init generates it): a lost or changed key makes the stored LLM API
# keys undecryptable, so they would have to be entered again
LLM_KEY_ENCRYPTION_KEY=

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###
