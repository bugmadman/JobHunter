{% extends 'base.html.twig' %}

{% block title %}{{ 'cv.upload.title'|trans }}{% endblock %}

{% block body %}
    <h1 class="h3">{{ 'cv.upload.title'|trans }}</h1>

    {% if settings_hint is defined %}
        {{ include('llm/_settings_missing.html.twig', {hint: settings_hint, url: settings_url}) }}
    {% else %}
        {% form_theme form 'bootstrap_5_layout.html.twig' %}
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit" class="btn btn-primary">{{ 'cv.upload.submit'|trans }}</button>
        {{ form_end(form) }}
    {% endif %}
{% endblock %}
