{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}{{ 'cv.upload.title'|trans }}{% endblock %}

{% block body %}
    <h1 class="h3">{{ 'cv.upload.title'|trans }}</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn btn-primary">{{ 'cv.upload.submit'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
