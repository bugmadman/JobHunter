{% extends 'base.html.twig' %}

{% block title %}{{ posting.title }}{% endblock %}

{% block body %}
    <h1 class="h4 text-break">{{ posting.title }}</h1>

    <turbo-frame id="posting-cover-letter">
        {% set status = cover_letter ? cover_letter.status.value %}
        {% if status == 'pending' %}
            <div class="alert alert-info" role="status" data-controller="frame-reload"
                 data-frame-reload-url-value="{{ path('app_cover_letter_show', {id: posting.id}) }}">
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                {{- 'cover_letter.show.pending'|trans -}}
            </div>
        {% elseif status == 'failed' %}
            <div class="alert alert-danger" role="alert">{{ 'cover_letter.show.failed'|trans }}</div>
        {% elseif status == 'done' %}
            <p class="small text-body-secondary mb-1">
                <time datetime="{{ cover_letter.createdAt|date('c') }}">
                    {{- cover_letter.createdAt|date('Y-m-d H:i') -}}
                </time>
            </p>
            <form method="post" action="{{ path('app_cover_letter_edit', {id: cover_letter.id}) }}" class="mb-3"
                  id="cover-letter-form" data-controller="clipboard"
                  data-clipboard-copied-label-value="{{ 'cover_letter.show.copied'|trans }}">
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                       value="{{ csrf_token('cover_letter_edit') }}">
                <label for="cover-letter-text" class="visually-hidden">{{ 'cover_letter.show.title'|trans }}</label>
                <textarea name="text" id="cover-letter-text" class="form-control mb-2" rows="12" required
                          data-clipboard-target="source">{{ cover_letter.text }}</textarea>
                <button type="submit" class="btn btn-sm btn-primary">{{ 'cover_letter.show.save'|trans }}</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-clipboard-target="button"
                        data-action="clipboard#copy">{{ 'cover_letter.show.copy'|trans }}</button>
            </form>
        {% else %}
            <p class="text-body-secondary">{{ 'cover_letter.show.none'|trans }}</p>
        {% endif %}

        {% if status != 'pending' %}
            <form method="post" action="{{ path('app_cover_letter_generate', {id: posting.id}) }}" class="mb-3">
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                       value="{{ csrf_token('cover_letter_generate') }}">
                <button type="submit" class="btn btn-primary btn-sm">
                    {{- (cover_letter ? 'cover_letter.show.regenerate' : 'cover_letter.show.generate')|trans -}}
                </button>
            </form>
        {% endif %}
    </turbo-frame>
{% endblock %}
