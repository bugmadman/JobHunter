{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ 'admin.api_key.title'|trans }}{% endblock %}

{% block main %}
    <p>{{ 'admin.api_key.description'|trans }}</p>

    {% if new_key %}
        <div class="alert alert-success" role="status">
            <p>{{ 'admin.api_key.generated'|trans }}</p>
            <code class="d-block user-select-all text-break" data-api-key>{{ new_key }}</code>
        </div>
    {% elseif has_key %}
        <p class="text-body-secondary">{{ 'admin.api_key.is_set'|trans }}</p>
        <p class="text-warning-emphasis">{{ 'admin.api_key.regenerate_warning'|trans }}</p>
    {% else %}
        <p class="text-body-secondary">{{ 'admin.api_key.not_set'|trans }}</p>
    {% endif %}

    <form method="post" action="{{ path('admin_api_key_regenerate') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('api_key_regenerate') }}" data-controller="csrf-protection">
        <button type="submit" class="btn btn-primary">
            {{- (has_key ? 'admin.api_key.regenerate' : 'admin.api_key.generate')|trans -}}
        </button>
    </form>

    <h2 class="h5 mt-4">{{ 'admin.api_key.bootstrap.title'|trans }}</h2>
    <p>{{ 'admin.api_key.bootstrap.description'|trans }}</p>
    {% if not new_key %}
        <p class="text-body-secondary">{{ 'admin.api_key.bootstrap.key_placeholder'|trans }}</p>
    {% endif %}
    <div data-controller="clipboard" data-clipboard-copied-label-value="{{ 'admin.api_key.bootstrap.copied'|trans }}">
        <label for="bootstrap-prompt" class="visually-hidden">{{ 'admin.api_key.bootstrap.title'|trans }}</label>
        <textarea id="bootstrap-prompt" class="form-control mb-2 font-monospace" rows="14" readonly
                  data-clipboard-target="source" data-bootstrap-prompt>
            {{- include('admin/_bootstrap_prompt.txt.twig', {
                base_url: app.request.schemeAndHttpHost,
                api_key: new_key ?: '<API key>',
            }) -}}
        </textarea>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-clipboard-target="button"
                data-action="clipboard#copy">{{ 'admin.api_key.bootstrap.copy'|trans }}</button>
    </div>
{% endblock %}
