{% extends 'base.html.twig' %}

{% block title %}{{ posting.title }}{% endblock %}

{% block body %}
    <p class="mb-2">
        <a href="{{ path('app_job_posting_index') }}">{{ 'job_posting.show.back'|trans }}</a>
    </p>

    <article id="posting-{{ posting.id }}">
        <turbo-frame id="posting-verdict">
            {{ include('job_posting/_badges.html.twig') }}
            {% if posting.verdict %}
                <form method="post" action="{{ path('app_job_posting_verdict', {id: posting.id}) }}"
                      class="d-flex flex-wrap align-items-center gap-2 mb-2" id="posting-verdict-form">
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                           value="{{ csrf_token('job_posting_verdict') }}">
                    <span class="small">{{ 'job_posting.show.your_verdict'|trans }}</span>
                    <div class="btn-group btn-group-sm" role="group">
                        {% for verdict in verdicts %}
                            {% set color = verdict.value == 'like' ? 'success' : 'danger' %}
                            {% set chosen = verdict == posting.effectiveVerdict %}
                            <button type="submit" name="verdict" value="{{ verdict.value }}"
                                    class="btn {{ chosen ? 'btn-' ~ color : 'btn-outline-' ~ color }}"
                                    aria-pressed="{{ chosen ? 'true' : 'false' }}">
                                {{- ('job_posting.verdict.' ~ verdict.value)|trans -}}
                            </button>
                        {% endfor %}
                    </div>
                    {% if posting.manualVerdict %}
                        <span class="small text-body-secondary" id="posting-llm-verdict">
                            {{- 'job_posting.show.llm_verdict'|trans({
                                '%verdict%': ('job_posting.verdict.' ~ posting.verdict.value)|trans,
                            }) -}}
                        </span>
                    {% endif %}
                </form>
            {% endif %}
        </turbo-frame>
        <h1 class="h4 text-break">{{ posting.title }}</h1>
        {% if posting.company or posting.location %}
            <p class="mb-1 text-break">{{ [posting.company, posting.location]|filter(v => v)|join(' · ') }}</p>
        {% endif %}
        <p class="small text-body-secondary">
            <time datetime="{{ posting.createdAt|date('c') }}">{{ posting.createdAt|date('Y-m-d H:i') }}</time>
            · <a href="{{ posting.url }}" target="_blank" rel="noopener noreferrer" id="posting-original">
                {{- 'job_posting.show.original'|trans -}}
            </a>
        </p>

        {% if posting.statusReason %}
            <section class="mb-3" id="posting-reason">
                <h2 class="h6">
                    {{- (posting.verdict ? 'job_posting.show.llm_reason' : 'job_posting.show.status_reason')|trans -}}
                </h2>
                <p class="border rounded p-2 mb-0 text-break">{{ posting.statusReason|nl2br }}</p>
            </section>
        {% endif %}

        <turbo-frame id="posting-comment">
            <form method="post" action="{{ path('app_job_posting_comment', {id: posting.id}) }}" class="mb-3"
                  id="posting-comment-form">
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                       value="{{ csrf_token('job_posting_comment') }}">
                <label for="posting-comment-text" class="form-label h6">{{ 'job_posting.show.comment'|trans }}</label>
                <textarea name="comment" id="posting-comment-text" class="form-control mb-2" rows="3"
                          maxlength="{{ comment_max_length }}">{{ posting.comment }}</textarea>
                <button type="submit" class="btn btn-sm btn-primary">{{ 'job_posting.show.save_comment'|trans }}</button>
            </form>
        </turbo-frame>

        <section id="posting-description">
            <h2 class="h6">{{ 'job_posting.show.description'|trans }}</h2>
            <p class="text-break">{{ posting.description|nl2br }}</p>
        </section>

        <section id="posting-history">
            <h2 class="h6">{{ 'job_posting.show.history'|trans }}</h2>
            <ol class="list-unstyled small">
                {% for log in history %}
                    <li class="border-start border-2 ps-2 mb-2">
                        <time datetime="{{ log.occurredAt|date('c') }}" class="text-body-secondary">
                            {{- log.occurredAt|date('Y-m-d H:i') -}}
                        </time>
                        ·
                        {% if log.from %}{{ ('job_posting.status.' ~ log.from.value)|trans }} → {% endif %}
                        {{- ('job_posting.status.' ~ log.to.value)|trans }}
                        {% if log.reason %}
                            <div class="text-body-secondary text-break">{{ log.reason|nl2br }}</div>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>
        </section>
    </article>
{% endblock %}
