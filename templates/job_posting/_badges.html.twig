<div class="d-flex flex-wrap gap-1 mb-2">
    <span class="badge text-bg-secondary">{{ posting.platform.name }}</span>
    <span class="badge text-bg-light border">{{ ('job_posting.status.' ~ posting.status.value)|trans }}</span>
    {% set verdict = posting.effectiveVerdict %}
    {% if verdict %}
        <span class="badge {{ verdict.value == 'like' ? 'text-bg-success' : 'text-bg-danger' }}">
            {{- ('job_posting.verdict.' ~ verdict.value)|trans -}}
            {%- if posting.manualVerdict %} · {{ 'job_posting.manual_verdict'|trans }}{% endif -%}
        </span>
    {% endif %}
</div>
