{
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-sodium": "*",
        "api-platform/doctrine-orm": "^5.0.9",
        "api-platform/symfony": ">=5.0.9",
        "doctrine/doctrine-bundle": "^3.4.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.8",
        "easycorp/easyadmin-bundle": "^5.10.2",
        "justinrainbow/json-schema": "^6.14",
        "symfony/asset": "~7.4.0",
        "symfony/asset-mapper": "~7.4.23",
        "symfony/clock": "~7.4.21",
        "symfony/console": "~7.4.23",
        "symfony/doctrine-messenger": "~7.4.23",
        "symfony/dotenv": "~7.4.0",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "~7.4.23",
        "symfony/http-client": "~7.4.23",
        "symfony/lock": "~7.4.23",
        "symfony/messenger": "~7.4.23",
        "symfony/rate-limiter": "~7.4.23",
        "symfony/runtime": "~7.4.23",
        "symfony/security-bundle": "~7.4.23",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/ux-turbo": "^3.7",
        "symfony/yaml": "~7.4.23"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.8",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "ergebnis/composer-normalize": "^2.58",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "phpro/grumphp": "^2.27.2",
        "phpstan/phpstan": "^2.3.7",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.1.2",
        "phpstan/phpstan-strict-rules": "^2.1.1",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^12.5.45",
        "rector/rector": "^2.8.5",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/browser-kit": "~7.4.23",
        "symfony/css-selector": "~7.4.22",
        "symfony/maker-bundle": "^1.68",
        "symfony/phpunit-bridge": "^8.1.10",
        "symfony/web-profiler-bundle": "~7.4.23"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "phpro/grumphp": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "docker": "false",
            "require": "7.4.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        }
    }
}
