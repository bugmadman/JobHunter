<?xml version="1.0" encoding="UTF-8"?>
<!-- Only the line length limit: PHP-CS-Fixer owns the rest of the style, but doesn't check line length -->
<ruleset name="JobHunter"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <arg name="extensions" value="php"/>
    <arg name="cache" value="var/phpcs.cache"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <file>bin/console</file>
    <file>config/</file>
    <file>public/</file>
    <file>src/</file>
    <file>tests/</file>

    <!-- Generated by Symfony -->
    <exclude-pattern>config/reference.php</exclude-pattern>
    <exclude-pattern>migrations/</exclude-pattern>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <!-- An error, not a warning: anything over the limit fails the check -->
            <property name="absoluteLineLimit" value="120"/>
        </properties>
    </rule>
</ruleset>
